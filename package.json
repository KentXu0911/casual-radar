{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "data:events": "node scripts/fetch-databrain-events.mjs",
    "data:youyansuo": "node scripts/normalize-youyansuo-discovery.mjs",
    "data:intelligence:clean": "node scripts/fetch-databrain-events.mjs --clean-only",
    "data:grp": "node scripts/sync-grp-reports.mjs",
    "data:attributions": "node --experimental-strip-types scripts/build-anomaly-attributions.mjs",
    "data:metrics": "node scripts/fetch-databrain-trends.mjs && node scripts/build-latest-databrain.mjs",
    "data:refresh": "npm run data:metrics && npm run data:events",
    "data:weekly": "node scripts/weekly-refresh.mjs",
    "data:weekly:dry-run": "node scripts/weekly-refresh.mjs --dry-run",
    "data:daily": "node scripts/daily-refresh.mjs",
    "data:daily:dry-run": "node scripts/daily-refresh.mjs --dry-run",
    "data:publication": "node scripts/record-publication.mjs",
    "data:development-profiles": "node scripts/build-development-profiles.mjs",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "vite build --config vite.pages.config.ts",
    "preview:pages": "vite preview --config vite.pages.config.ts --host 127.0.0.1 --port 4173",
    "typecheck:pages": "tsc --noEmit --project tsconfig.pages.json",
    "test:pages": "npm run typecheck:pages && npm test && npm run build:pages && node --test tests/pages/*.test.mjs",
    "github:publish": "node scripts/publish-github-pages.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "content:begin": "node scripts/content-workflow.mjs begin",
    "content:queue": "node scripts/content-workflow.mjs queue",
    "content:finalize": "node scripts/content-workflow.mjs finalize",
    "content:audit": "node scripts/content-workflow.mjs audit",
    "content:abort": "node scripts/content-workflow.mjs abort",
    "content:prepare": "node scripts/content-workflow.mjs prepare",
    "release:manifest": "node scripts/prepare-release.mjs",
    "prebuild": "npm run content:prepare && npm run release:manifest",
    "prebuild:pages": "npm run content:prepare && npm run release:manifest",
    "data:intelligence": "node scripts/intelligence-refresh.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
